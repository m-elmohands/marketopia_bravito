/vendor

# Environment files
.env
.env.backup
.env.production

# Storage - User uploaded files and dynamic content
/storage/*.key
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Storage - Framework cache (generated files)
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep

# Keep important storage structure files
!/storage/framework/.gitignore
!/storage/app/.gitignore

# Public storage symlink
/public/storage
/public/hot

# Uploaded assets (user uploads only)
/public/uploads
/public/images

# Cache
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# IDE files
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.phpunit.result.cache
coverage

# Composer
composer.lock
composer.phar
